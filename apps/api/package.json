{
  "name": "@ai-expenses/api",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/router.ts"
    }
  },
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/index.ts",
    "build": "bun build src/index.ts --target=bun --outdir=dist",
    "start": "NODE_ENV=production bun --env-file=../../.env dist/index.js",
    "typecheck": "bun --bun run tsc --noEmit",
    "test": "bun test src",
    "db:generate": "bun --env-file=../../.env --bun run drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env src/db/migrate.ts",
    "account": "bun --env-file=../../.env src/auth/command.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.117",
    "@better-auth/drizzle-adapter": "1.7.25",
    "@trpc/server": "11.28.0",
    "ai": "^7.0.169",
    "better-auth": "1.7.25",
    "drizzle-orm": "^0.45.4",
    "superjson": "^2.2.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11"
  }
}
