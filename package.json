{
  "name": "ai-expenses",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --parallel --filter './apps/*' dev",
    "dev:api": "bun run --filter @ai-expenses/api dev",
    "dev:web": "bun run --filter @ai-expenses/web dev",
    "build": "bun run typecheck && bun run --filter './apps/*' build",
    "typecheck": "bun run --filter './apps/*' typecheck",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "bun test apps/api/src",
    "smoke": "bun run --filter @ai-expenses/web smoke",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "db:generate": "bun run --filter @ai-expenses/api db:generate",
    "db:migrate": "bun run --filter @ai-expenses/api db:migrate",
    "db:shell": "docker compose exec db sh -c 'psql -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\"'"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
