# Local development database. Keep DATABASE_URL in sync with POSTGRES_*.
POSTGRES_USER=ai_expenses
POSTGRES_PASSWORD=ai_expenses
POSTGRES_DB=ai_expenses
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ai_expenses:ai_expenses@127.0.0.1:5432/ai_expenses

# Used by the API and Vite's development/preview proxy.
API_PORT=3001

GOOGLE_GENERATIVE_AI_API_KEY=

# Browser origin. Use HTTPS in production; use port 4173 for local preview.
BETTER_AUTH_URL=http://localhost:5173
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=
# Comma-separated approved email addresses. Restart the API after changes.
AUTH_ALLOWED_EMAILS=you@example.com
